# Copy to backend/.env (gitignored) and fill in. Deployments set the same names
# as real environment variables instead, which take precedence over this file.

# IBM Quantum API token from https://quantum.cloud.ibm.com — enables 実機モード.
# Without it the app runs simulator-only and the hardware panel stays hidden.
IBM_QUANTUM_TOKEN=

# Optional. Open Plan users can leave these empty.
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
# Pin a device (e.g. ibm_torino); empty = least busy operational QPU.
IBM_QUANTUM_BACKEND=

# QPU quota guards. A measured downscaled job bills 2 s of the ~600 s/month the
# Open Plan grants, and a deployed instance shares one token with every visitor,
# so these caps are process-wide rather than per-player. 6/day ~= 360 s/month.
IBM_QUANTUM_SHOTS=1024
IBM_QUANTUM_MAX_JOBS_PER_HOUR=3
IBM_QUANTUM_MAX_JOBS_PER_DAY=6

# Set to 0 to keep the credential but turn hardware mode off.
HARDWARE_ENABLED=1

# Only needed when the frontend is served from a different origin than the API.
# ALLOWED_ORIGINS=https://example.com
